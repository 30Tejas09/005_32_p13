classDiagram
    class User {
        +int id
        +string username
        +string password_hash
        +string role
        +string full_name
        +string email
        +datetime created_at
    }

    class Zone {
        +int id
        +string zone_code
        +string name
        +text description
        +boolean is_active
    }

    class Handler {
        +int id
        +string handler_code
        +string name
        +int zone_id
        +text supported_categories
        +boolean is_available
        +int max_capacity
        +int current_workload
        +boolean is_backup_eligible
    }

    class Report {
        +int id
        +string report_code
        +string reporter_name
        +string signal_id
        +int zone_id
        +string location
        +text description
        +string category
        +string priority
        +string status
        +datetime created_at
    }

    class RoutingRule {
        +int id
        +int zone_id
        +string category
        +int primary_handler_id
        +int backup_handler_id
        +string escalation_path
        +boolean is_active
    }

    class Assignment {
        +int id
        +int report_id
        +int handler_id
        +datetime assigned_at
        +string status
        +string assignment_type
        +datetime completed_at
        +text resolution_notes
    }

    class StatusHistory {
        +int id
        +int report_id
        +string previous_status
        +string new_status
        +string updated_by
        +text remarks
        +datetime created_at
    }

    class DispatchLog {
        +int id
        +int report_id
        +string decision
        +text reason
        +int primary_handler_id
        +int assigned_handler_id
        +boolean is_backup
        +boolean is_escalated
        +datetime timestamp
    }

    class ClassificationLog {
        +int id
        +int report_id
        +string detected_category
        +text matched_categories
        +float confidence_score
        +string resolution_rule
        +boolean is_manual_override
        +datetime timestamp
    }

    Zone "1" --> "*" Handler : employs
    Zone "1" --> "*" Report : encompasses
    Zone "1" --> "*" RoutingRule : governs
    Handler "1" --> "*" RoutingRule : primary_for
    Handler "1" --> "*" RoutingRule : backup_for
    Handler "1" --> "*" Assignment : executes
    Report "1" --> "*" Assignment : tracked_in
    Report "1" --> "*" StatusHistory : transitions
    Report "1" --> "*" DispatchLog : generates
    Report "1" --> "*" ClassificationLog : audited_by
